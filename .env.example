DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

AMAP_KEY=replace_with_your_amap_web_service_key
ROUTESNAP_ACCESS_TOKEN=replace_with_a_long_random_token
ROUTESNAP_DOMAIN=api.example.com

ROUTESNAP_HOST=127.0.0.1
ROUTESNAP_PORT=5001
ROUTESNAP_DATA_DIR=/var/lib/routesnap-share
XHS_FETCH_TIMEOUT=10
